# Copy this file to .env and fill in real values. Never commit .env itself.

POSTGRES_USER=sportiq
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sportiq

# Get a free-tier token at https://www.football-data.org/
SPORTS_API_KEY=your_football_data_org_token

# Get a free-tier key at https://the-odds-api.com/
ODDS_API_KEY=your_odds_api_key

# The URL the frontend uses to reach the backend, baked in at build time.
# Locally: http://localhost:5000
# On the live server behind nginx/HTTPS: use /api (not a direct http:// IP —
# a plain http:// call from an https:// page gets silently blocked by the
# browser as "mixed content", which nginx's /api/ proxy avoids)
VITE_API_URL=http://localhost:5000